cabal-version:      2.4
name:               chopaan-viz
version:            0.1.0.0
synopsis:           Dear ImGui playground for chopaan grid feeders (algebraic-graphs + FFI Hopfield kernel)
build-type:         Simple

executable chopaan-viz
    main-is:            Main.hs
    hs-source-dirs:     app
    other-modules:      Kernel
                      , Feeder

    -- The categorified Hopfield kernel (Haskell -> C via Categorifier) is
    -- compiled straight into the binary and called over FFI (see Kernel.hs).
    c-sources:          cbits/hopfield_step.c
    include-dirs:       cbits
    extra-libraries:    m

    build-depends:      base              >=4.13 && <5
                      , dear-imgui        >=2.0
                      , sdl2              >=2.5
                      , gl
                      , managed
                      , containers
                      , algebraic-graphs  >=0.5
                      , aeson
                      , bytestring
                      , text

    default-language:   Haskell2010
    ghc-options:        -O2 -threaded -Wall -Wno-unused-imports

    -- dear-imgui's SDL + OpenGL3 backends (default flags). If your dear-imgui
    -- needs them explicitly: cabal build -f sdl -f opengl3
